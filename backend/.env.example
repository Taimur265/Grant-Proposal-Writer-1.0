# Application Settings
APP_NAME="Grant Proposal Writer"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/grant_writer
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/grant_writer

# JWT Settings
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider Settings (at least one required)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DEFAULT_AI_PROVIDER=openai
DEFAULT_MODEL=gpt-4-turbo-preview

# File Upload Settings
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads

# Storage Settings
STORAGE_TYPE=local

# S3/MinIO Settings (optional, for cloud storage)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=grant-proposals
# S3_REGION=us-east-1

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
